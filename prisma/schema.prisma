generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  MEETING_BOOKED
  CLIENT
  CLOSED
}

enum ImportStatus {
  PENDING
  APPROVED
  SKIPPED
  FAILED
}

model Company {
  id           String   @id @default(uuid())
  businessName String
  website      String?
  instagram    String?
  email        String?
  phone        String?
  city         String?
  status       Status   @default(NEW)
  notes        String?
  isPinned     Boolean  @default(false)
  followUpDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  importedFrom ImportCompany[]
  groups       Group[]
  timelineNotes Note[]
  outreachSessions OutreachSessionCompany[]
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  DISCARDED
}

enum SessionCompanyState {
  PENDING
  CURRENT
  COMPLETED
  SKIPPED
}

model OutreachSession {
  id               String   @id @default(uuid())
  status           SessionStatus @default(ACTIVE)
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  currentCompanyId String?
  filtersSnapshot  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companies        OutreachSessionCompany[]
}

model OutreachSessionCompany {
  id           String   @id @default(uuid())
  sessionId    String
  companyId    String
  session      OutreachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queuePosition Int
  state        SessionCompanyState @default(PENDING)
  completedAt  DateTime?

  @@unique([sessionId, companyId])
}

model Note {
  id        String   @id @default(uuid())
  content   String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id        String    @id @default(uuid())
  name      String
  companies Company[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ImportCompany {
  id           String       @id @default(uuid())
  businessName String
  website      String?
  instagram    String?
  email        String?
  phone        String?
  city         String?
  status       Status       @default(NEW)
  notes        String?
  importStatus ImportStatus @default(PENDING)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

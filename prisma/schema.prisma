generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  MEETING_BOOKED
  CLIENT
  CLOSED
}

model Company {
  id           String   @id @default(uuid())
  businessName String
  website      String?
  instagram    String?
  email        String?
  phone        String?
  city         String?
  status       Status   @default(NEW)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
